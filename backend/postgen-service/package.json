{
  "name": "postgen-service",
  "version": "1.0.0",
  "description": "文字封面生成服务：postgen2 修改版源码 + HTTP /render 包装",
  "type": "module",
  "private": true,
  "bin": {
    "postgen": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node server.js",
    "template:list": "tsx src/cli.ts template --action list",
    "test": "vitest run"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@shuding/opentype.js": "1.4.0-beta.0",
    "budoux": "^0.7.0",
    "conf": "^15.1.0",
    "react": "19.2.4",
    "satori": "0.19.1",
    "sharp": "0.34.4",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
