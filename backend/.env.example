# 部署环境变量模板：复制为 backend/app/.env 后修改
# backend/app/ 已 gitignore，凭据不会进入仓库
# 这里只放部署时经常需要修改的项；其余配置项及其默认值见 backend/CONFIG.md

# ---------- 数据库 [必须修改] ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lost_found
DB_USERNAME=root
DB_PASSWORD=your_db_password

# ---------- 邮件 [必须修改] ----------
MAIL_HOST=your_smtp_host
MAIL_PORT=465
MAIL_USERNAME=your_email
MAIL_PASSWORD=your_mail_password

# ---------- JWT [必须修改] ----------
JWT_SECRET=your_jwt_secret

# ---------- 部署相关 ----------
SERVER_PORT=8080
SITE_BASE_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
APP_UPLOAD_PATH=./uploads
POSTGEN_ENABLED=true
# postgen 服务地址（jar 模式默认本机 3000；postgen 在其他机器/端口时必改）
POSTGEN_BASE_URL=http://localhost:3000
# postgen 监听端口（start-app*.bat/sh 自动启动 postgen 时使用，须与 POSTGEN_BASE_URL 端口一致）
POSTGEN_PORT=3000

# ---------- 反向代理与客户端真实 IP ----------
# jar 直连部署：保持默认即可（native + 空信任列表 = 不解析 X-Forwarded-For，
# 直接使用连接方 IP，且不怕伪造）
# 分拆部署（前端机反向代理）时：填前端机 IP（逗号分隔多个），例如：
# FORWARDED_TRUSTED_PROXIES=192.168.1.10
FORWARD_HEADERS_STRATEGY=native
FORWARDED_TRUSTED_PROXIES=
